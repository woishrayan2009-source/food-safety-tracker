# --- Frontend (Vite) env vars ---
# These are exposed to the browser bundle. Only put PUBLIC/safe values here.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Netlify Functions env vars (server-side only, set in Netlify dashboard) ---
# These NEVER get bundled into the frontend. AI calls happen here, not in the browser.
# Required by netlify/functions/save-profile.js, lookup-barcode.js, get-summary.js,
# search-food.js, and explain-result.js to write/read with elevated DB access:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required by netlify/functions/lookup-barcode.js:
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v0
# Required by netlify/functions/parse-label.js (Step 1 — OCR):
OCR_API_KEY=your-ocr-provider-key
# Required by netlify/functions/parse-label.js (Step 2 — AI structuring) and
# netlify/functions/explain-result.js (turns a risk-check.js verdict into plain language):
AI_API_KEY=your-anthropic-or-other-ai-provider-key

# NOTE: netlify/functions/risk-check.js needs none of the above — it's a pure, deterministic
# rule engine with no external calls. netlify/functions/get-summary.js and explain-result.js
# also verify the caller's identity via their Supabase auth JWT (Authorization: Bearer <token>
# header), using VITE_SUPABASE_ANON_KEY above, rather than trusting a user id from the request
# body.
