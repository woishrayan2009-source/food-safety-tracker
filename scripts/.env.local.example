# Env vars for MANUAL, LOCAL-ONLY scripts (currently just seed-food-database.js).
#
# Copy this file to scripts/.env.local and fill in real values:
#   cp scripts/.env.local.example scripts/.env.local
#
# scripts/.env.local is gitignored and must NEVER be committed — it holds the Supabase
# service-role key, which bypasses Row Level Security. This is separate from the root
# .env.example (frontend + deployed Netlify Functions config); nothing in this file is ever
# bundled into the app or uploaded to Netlify.

# Same Supabase project as the app. Get both from Supabase dashboard > Project Settings > API.
VITE_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
